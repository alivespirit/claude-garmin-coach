[Unit]
Description=Garmin coach (Telegram bot + workout analysis with Claude Code)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@DIR@
EnvironmentFile=@DIR@/config.env
Environment=PATH=@HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=@DIR@/.venv/bin/python @DIR@/bot.py
Restart=always
RestartSec=60
# Low priority: the server's own processing always wins.
Nice=10
CPUWeight=20
IOSchedulingClass=idle

# Sandbox: the bot, Claude Code and the Garmin MCP server see the whole system read-only and
# can write only to this folder, Claude Code's own state and the Garmin tokens (refreshed in
# place). Using a custom GARMINTOKENS path? Add it here.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@DIR@ @HOME@/.claude @HOME@/.claude.json @HOME@/.garminconnect

[Install]
WantedBy=multi-user.target
