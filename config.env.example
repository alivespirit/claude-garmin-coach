# claude-garmin-coach configuration. Copy to config.env (install.sh does this) and fill in.
# Plain KEY=VALUE lines; read by bot.py and by systemd (EnvironmentFile).

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your Telegram chat id. Leave empty, start the bot and send it any message:
# it replies with your id. The bot ignores every other chat.
TELEGRAM_CHAT_ID=

# Claude Code login for a headless server: run `claude setup-token`, then
# uncomment and paste the token. Not needed where you're logged in interactively.
# CLAUDE_CODE_OAUTH_TOKEN=

# No background auto-updates or telemetry (update by hand: `claude update`).
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# ---- Optional (defaults shown) ----
# TELEGRAM_POLL_SECONDS=25
# GARMIN_POLL_MINUTES=15
# Activity types that are not analyzed automatically (comma-separated Garmin type keys)
# SKIP_ACTIVITY_TYPES=walking
# CLAUDE_TIMEOUT_MINUTES=10
# CLAUDE_MODEL=
# CLAUDE_BIN=/home/USER/.local/bin/claude
# GARMINTOKENS=~/.garminconnect

# Weather location for activities without GPS (GPS off, treadmill, strength)
# HOME_LATITUDE=50.45
# HOME_LONGITUDE=30.52
